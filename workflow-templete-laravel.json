{
    "name": "__DOMAIN__ Laravel Provision",
    "site_addresses": [
        "example.com"
    ],
    "nodes": [
        {
            "id": "create-server",
            "type": "custom",
            "data": {
                "label": "Create Server",
                "action": {
                    "id": "create-server",
                    "label": "Create Server",
                    "category": "server",
                    "handler": "App\\WorkflowActions\\Server\\CreateServer",
                    "starting": true,
                    "inputs": {
                        "name": "__DOMAIN__",
                        "provider": "hetzner",
                        "plan": "cx33",
                        "region": "hel1",
                        "os": "ubuntu_24"
                    }
                }
            }
        },
        {
            "id": "install-nginx",
            "type": "custom",
            "data": {
                "label": "Install Nginx",
                "action": {
                    "id": "install-service",
                    "label": "Install Nginx",
                    "category": "service",
                    "handler": "App\\WorkflowActions\\Service\\InstallService",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "name": "nginx",
                        "version": "latest"
                    }
                }
            }
        },
        {
            "id": "install-php",
            "type": "custom",
            "data": {
                "label": "Install PHP 8.4",
                "action": {
                    "id": "install-service",
                    "label": "Install PHP 8.4",
                    "category": "service",
                    "handler": "App\\WorkflowActions\\Service\\InstallService",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "name": "php",
                        "version": "8.4"
                    }
                }
            }
        },
        {
            "id": "install-postgresql",
            "type": "custom",
            "data": {
                "label": "Install PostgreSQL 18",
                "action": {
                    "id": "install-service",
                    "label": "Install PostgreSQL 18",
                    "category": "service",
                    "handler": "App\\WorkflowActions\\Service\\InstallService",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "name": "postgresql",
                        "version": "18"
                    }
                }
            }
        },
        {
            "id": "install-redis",
            "type": "custom",
            "data": {
                "label": "Install Redis",
                "action": {
                    "id": "install-service",
                    "label": "Install Redis",
                    "category": "service",
                    "handler": "App\\WorkflowActions\\Service\\InstallService",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "name": "redis",
                        "version": "latest"
                    }
                }
            }
        },
        {
            "id": "install-supervisor",
            "type": "custom",
            "data": {
                "label": "Install Supervisor",
                "action": {
                    "id": "install-service",
                    "label": "Install Supervisor",
                    "category": "service",
                    "handler": "App\\WorkflowActions\\Service\\InstallService",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "name": "supervisor",
                        "version": "latest"
                    }
                }
            }
        },
        {
            "id": "install-nodejs",
            "type": "custom",
            "data": {
                "label": "Install Node.js 22",
                "action": {
                    "id": "install-service",
                    "label": "Install Node.js 22",
                    "category": "service",
                    "handler": "App\\WorkflowActions\\Service\\InstallService",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "name": "nodejs",
                        "version": "22"
                    }
                }
            }
        },
        {
            "id": "create-database",
            "type": "custom",
            "data": {
                "label": "Create Database",
                "action": {
                    "id": "create-database",
                    "label": "Create Database",
                    "category": "database",
                    "handler": "App\\WorkflowActions\\Database\\CreateDatabase",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "name": "__DATABASE_NAME__",
                        "charset": "UTF8",
                        "collation": "en_US.UTF-8"
                    }
                }
            }
        },
        {
            "id": "create-database-user",
            "type": "custom",
            "data": {
                "label": "Create Database User",
                "action": {
                    "id": "create-database-user",
                    "label": "Create Database User",
                    "category": "database",
                    "handler": "App\\WorkflowActions\\Database\\CreateDatabaseUser",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "username": "__DATABASE_USERNAME__",
                        "password": "__DATABASE_PASSWORD__",
                        "remote": false,
                        "databases": [
                            "__DATABASE_NAME__"
                        ],
                        "permission": "admin"
                    }
                }
            }
        },
        {
            "id": "create-laravel-site",
            "type": "custom",
            "data": {
                "label": "Create Laravel Site",
                "action": {
                    "id": "create-laravel-site",
                    "label": "Create Laravel Site",
                    "category": "site",
                    "handler": "App\\WorkflowActions\\Site\\CreateLaravelSite",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "type": "laravel",
                        "user": "__SITE_USER__",
                        "php_version": "8.4",
                        "source_control": "__SOURCE_CONTROL_TOKEN__",
                        "repository": "__REPOSITORY__",
                        "branch": "main",
                        "web_directory": "public",
                        "composer": true
                    }
                }
            }
        },
        {
            "id": "write-env",
            "type": "custom",
            "data": {
                "label": "Write .env and Setup Laravel",
                "action": {
                    "id": "run-command",
                    "label": "Write .env and Setup Laravel",
                    "category": "general",
                    "handler": "App\\WorkflowActions\\General\\RunCommand",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "user": "__SITE_USER__",
                        "command": "cd {site_path} && php -r 'file_put_contents(\".env\", implode(PHP_EOL, [\"APP_NAME=__APP_NAME__\", \"APP_ENV=production\", \"APP_KEY=base64:\".base64_encode(random_bytes(32)), \"APP_DEBUG=true\", \"APP_URL=__APP_URL__\", \"\", \"LOG_CHANNEL=stack\", \"LOG_LEVEL=error\", \"\", \"DB_CONNECTION=pgsql\", \"DB_HOST=127.0.0.1\", \"DB_PORT=5432\", \"DB_DATABASE=__DATABASE_NAME__\", \"DB_USERNAME=__DATABASE_USERNAME__\", \"DB_PASSWORD=__DATABASE_PASSWORD__\", \"\", \"CACHE_STORE=redis\", \"QUEUE_CONNECTION=redis\", \"SESSION_DRIVER=redis\", \"\", \"REDIS_HOST=127.0.0.1\", \"REDIS_PASSWORD=null\", \"REDIS_PORT=6379\", \"\"]).PHP_EOL);' && php8.4 artisan migrate --force && php8.4 artisan db:seed --force && php8.4 artisan storage:link || true"
                    }
                }
            }
        },
        {
            "id": "install-docker",
            "type": "custom",
            "data": {
                "label": "Install Docker",
                "action": {
                    "id": "run-command",
                    "label": "Install Docker",
                    "category": "general",
                    "handler": "App\\WorkflowActions\\General\\RunCommand",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "user": "root",
                        "command": "curl -fsSL https://get.docker.com -o get-docker.sh && sh get-docker.sh"
                    }
                }
            }
        },
        {
            "id": "create-horizon-worker",
            "type": "custom",
            "data": {
                "label": "Create Horizon Worker",
                "action": {
                    "id": "create-worker",
                    "label": "Create Horizon Worker",
                    "category": "worker",
                    "handler": "App\\WorkflowActions\\Worker\\CreateWorker",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "site_id": "{site_id}",
                        "name": "Horizon",
                        "command": "php8.4 artisan horizon",
                        "user": "__SITE_USER__",
                        "auto_start": true,
                        "auto_restart": true,
                        "numprocs": 1
                    }
                }
            }
        },
        {
            "id": "create-bridge-worker",
            "type": "custom",
            "data": {
                "label": "Create Bridge Worker",
                "action": {
                    "id": "create-worker",
                    "label": "Create Bridge Worker",
                    "category": "worker",
                    "handler": "App\\WorkflowActions\\Worker\\CreateWorker",
                    "starting": false,
                    "inputs": {
                        "server_id": "{server_id}",
                        "site_id": "{site_id}",
                        "name": "Bridge",
                        "command": "php8.4 artisan bridge",
                        "user": "__SITE_USER__",
                        "auto_start": true,
                        "auto_restart": true,
                        "numprocs": 1
                    }
                }
            }
        }
    ],
    "edges": [
        {
            "id": "create-server-install-nginx",
            "source": "create-server",
            "target": "install-nginx",
            "type": "smoothstep",
            "animated": true,
            "data": {
                "status": "success"
            }
        },
        {
            "id": "install-nginx-install-php",
            "source": "install-nginx",
            "target": "install-php",
            "type": "smoothstep",
            "animated": true,
            "data": {
                "status": "success"
            }
        },
        {
            "id": "install-php-install-postgresql",
