            }
        },
        {
            "id": "install-docker-create-database",
            "source": "install-docker",
            "target": "create-database",
            "type": "smoothstep",
            "animated": true,
            "data": {
                "status": "success"
            }
        },
        {
            "id": "create-database-create-database-user",
            "source": "create-database",
            "target": "create-database-user",
            "type": "smoothstep",
            "animated": true,
            "data": {
                "status": "success"
            }
        },
        {
            "id": "create-database-user-create-laravel-site",
            "source": "create-database-user",
            "target": "create-laravel-site",
            "type": "smoothstep",
            "animated": true,
            "data": {
                "status": "success"
            }
        },
        {
            "id": "create-laravel-site-write-env",
            "source": "create-laravel-site",
            "target": "write-env",
            "type": "smoothstep",
            "animated": true,
