        "action": {
          "id": "install-service",
          "label": "Install Nginx",
          "category": "service",
          "handler": "App\\WorkflowActions\\Service\\InstallService",
          "starting": false,
          "inputs": {
            "server_id": "{server_id}",
            "name": "nginx",
            "version": "latest"
          },
          "outputs": {
            "server_id": "The ID of the server the service was installed on",
